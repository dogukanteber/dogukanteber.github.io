---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
}

const { src, alt } = Astro.props;
---

<figure>
  <Image src={src} alt={alt} />
  {
    Astro.slots.has('default') && (
      <figcaption>
        <slot />
      </figcaption>
    )
  }
</figure>
